{% comment %}
  CoolPaws Co. — Animated Hero Section
  Include in your homepage with: {% render 'coolpaws-hero' %}
{% endcomment %}

<section class="cp-hero">
  <div class="cp-hero__bg-circles">
    <div class="cp-hero__circle cp-hero__circle--1"></div>
    <div class="cp-hero__circle cp-hero__circle--2"></div>
    <div class="cp-hero__circle cp-hero__circle--3"></div>
  </div>

  <div class="cp-hero__content">
    <span class="cp-hero__badge">🐾 Summer 2026 Collection</span>
    <h1 class="cp-hero__title">
      Keep Your Pet <span>Cool</span><br>All Summer Long
    </h1>
    <p class="cp-hero__subtitle">
      Self-cooling mats designed for dogs &amp; cats. Non-toxic, washable, and portable — perfect for hot days.
    </p>
    <a href="/collections/all" class="cp-hero__cta">Shop Now →</a>
  </div>
</section>

<section style="max-width:1200px; margin:0 auto; padding:0 20px;">
  <div class="cp-features">
    <div class="cp-feature-card cp-fade-up">
      <span class="cp-feature-card__icon">❄️</span>
      <h3 class="cp-feature-card__title">Self-Cooling</h3>
      <p class="cp-feature-card__text">No electricity or water needed. Activates with your pet's body heat.</p>
    </div>
    <div class="cp-feature-card cp-fade-up">
      <span class="cp-feature-card__icon">🧼</span>
      <h3 class="cp-feature-card__title">Easy to Wash</h3>
      <p class="cp-feature-card__text">Machine washable and quick-drying. Always fresh and clean.</p>
    </div>
    <div class="cp-feature-card cp-fade-up">
      <span class="cp-feature-card__icon">🌿</span>
      <h3 class="cp-feature-card__title">Non-Toxic</h3>
      <p class="cp-feature-card__text">Safe materials for your furry friends. Vet-approved design.</p>
    </div>
    <div class="cp-feature-card cp-fade-up">
      <span class="cp-feature-card__icon">🎒</span>
      <h3 class="cp-feature-card__title">Portable</h3>
      <p class="cp-feature-card__text">Lightweight and foldable. Take it to the park, beach, or travel.</p>
    </div>
  </div>
</section>
